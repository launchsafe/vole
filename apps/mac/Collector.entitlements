<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- vole-collector only. Hardened Runtime blocks W^X executable-memory allocation by
     default, which V8 needs for JIT — without this, node crashes instantly on launch
     with FatalProcessOutOfMemory during Isolate::Init. Vole.swift runs no JIT'd code
     and is signed without these. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
