# Dependencies
node_modules/

# Build output
dist/
.build/
.swiftpm/

# Docs build output — regenerate with `pnpm docs:pdf`. Neither is committed: a 1.6 MB
# generated PDF in git history is churn, and it re-renders from the markdown on demand.
docs/.docs-bundle.html
docs/Vole-Documentation.pdf

# App-icon build (source SVGs + build.mjs + Resources/AppIcon.png are committed;
# these are regenerated by apps/mac/bundle.sh)
apps/mac/build/
apps/mac/Icon/preview/
apps/mac/Icon/Vole.iconset/
# Vole.icns is NOT ignored: it is committed prebuilt, because bundle.sh must work on a
# fresh clone and regenerating it needs sharp, which is not a lockfile dependency.

# Local tooling
.playwright-mcp/
*.log

# OS / editors
.DS_Store
.obsidian/
